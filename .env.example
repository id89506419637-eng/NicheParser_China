# NicheParser_China — Environment Variables
# Скопируй этот файл как .env и заполни значения

# === Flask ===
# Сгенерируй случайный ключ (иначе прод-режим откажется стартовать):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-random-string-at-least-32-chars
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# === OpenRouter (AI-классификация) ===
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Бесплатные модели (rate-limit ~20/мин, ~200/день):
#   meta-llama/llama-3.3-70b-instruct:free, qwen/qwen3-next-80b-a3b-instruct:free
# Платные (без жёстких лимитов):
#   google/gemini-2.0-flash-001 (~$0.10/1M токенов), anthropic/claude-3.5-haiku, openai/gpt-4o-mini
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# === Yandex.Direct (Wordstat) ===
# Получить: direct.yandex.ru → oauth.yandex.ru
# Пока токена нет — оставь пустым, парсер возьмёт mock-данные
YANDEX_OAUTH_TOKEN=
USE_MOCK_WORDSTAT=1

# === Alibaba ===
# Alibaba активно блокирует скрейпинг. Mock даёт правдоподобные товары
# для end-to-end демо без антибот-прокси. Для реального парсинга
# нужен residential proxy или ScraperAPI/ZenRows — тогда поставь 0.
USE_MOCK_ALIBABA=1

# === Модули (флаги включения) ===
ENABLE_WORDSTAT=1
ENABLE_ALIBABA=1
ENABLE_AVITO=0

# === Переопределение настроек ВЭД (опционально) ===
# VAT_PERCENT=22.0
# DEFAULT_DUTY_PERCENT=10.0
# MIN_MARGIN_PERCENT=50.0
# MIN_MARGIN_TOTAL_RUB=100000
